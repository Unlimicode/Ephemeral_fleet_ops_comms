# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fleet_ops_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ── Seed (test credentials only — do not use in production) ───────────────
TEST_MANAGER_EMAIL=manager@fleetops.dev
TEST_MANAGER_PASSWORD=FleetOps2026!

# ── Email (Brevo transactional API) ──────────────────────────────────────
# All mail is sent through backend/config/mailer.js via the Brevo API client.
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=noreply@swiftlink.app
# Address that corporate enquiry / contact-form submissions are forwarded to.
CONTACT_ENQUIRY_EMAIL=ops@swiftlink.app

# ── Web Push (VAPID) ───────────────────────────────────────────────────────────
# Generate keys once: node -e "import('web-push').then(m => console.log(m.default.generateVAPIDKeys()))"
# Store the output here. Never commit real keys to the repository.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_MAILTO=mailto:admin@fleetops.dev

# ── Flight status lookup (AviationStack) ─────────────────────────────────
# Optional. Enables flight-number ETA enrichment on bookings; unset = feature off.
AVIATIONSTACK_KEY=your_aviationstack_key_here

# ── Dev tunnelling (root start-dev.js only) ──────────────────────────────
# Used by `npm run dev` at the repo root to open an ngrok tunnel for phone testing.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
